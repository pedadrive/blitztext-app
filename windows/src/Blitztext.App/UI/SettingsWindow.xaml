<Window x:Class="Blitztext.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blitztext – Einstellungen"
        Width="460" Height="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#FFF7F7F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Blitztext" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Sprache rein. Text raus." Foreground="#FF6B7280" Margin="0,2,0,12" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="OpenAI API Key" FontWeight="SemiBold" Margin="0,8,0,4" />
                <PasswordBox x:Name="ApiKeyBox" Height="30" />
                <TextBlock Text="Wird sicher im Windows-Anmeldeinformations-Manager gespeichert."
                           Foreground="#FF9CA3AF" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                <Button x:Name="SaveKeyButton" Content="API Key speichern" Height="30" Margin="0,8,0,0"
                        Click="SaveKeyButton_Click" />

                <Separator Margin="0,16,0,12" />

                <TextBlock Text="Sprache (ISO, z. B. de, en)" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="LanguageBox" Height="30" />

                <TextBlock Text="Hotkey-Modus" FontWeight="SemiBold" Margin="0,12,0,4" />
                <ComboBox x:Name="HotkeyModeBox" Height="30">
                    <ComboBoxItem Content="Halten (Push-to-Talk)" />
                    <ComboBoxItem Content="Drücken (Umschalten)" />
                </ComboBox>

                <TextBlock Text="Ton (Blitztext+)" FontWeight="SemiBold" Margin="0,12,0,4" />
                <ComboBox x:Name="ToneBox" Height="30">
                    <ComboBoxItem Content="Formell" />
                    <ComboBoxItem Content="Neutral" />
                    <ComboBoxItem Content="Locker" />
                </ComboBox>

                <TextBlock Text="Emoji-Dichte (Blitztext :)" FontWeight="SemiBold" Margin="0,12,0,4" />
                <ComboBox x:Name="EmojiDensityBox" Height="30">
                    <ComboBoxItem Content="Wenig" />
                    <ComboBoxItem Content="Mittel" />
                    <ComboBoxItem Content="Viel" />
                </ComboBox>

                <TextBlock Text="Eigennamen / Fachbegriffe (Komma-getrennt)" FontWeight="SemiBold" Margin="0,12,0,4" />
                <TextBox x:Name="CustomTermsBox" Height="30" />

                <Separator Margin="0,16,0,12" />

                <CheckBox x:Name="SecureLocalModeBox" Content="Sicherer Lokaler Modus (Transkription bleibt auf dem Gerät)"
                          FontWeight="SemiBold" />
                <TextBlock Text="Lokales Whisper-Modell" FontWeight="SemiBold" Margin="0,12,0,4" />
                <ComboBox x:Name="LocalModelBox" Height="30" />
                <Button x:Name="InstallModelButton" Content="Modell herunterladen" Height="30" Margin="0,8,0,0"
                        Click="InstallModelButton_Click" />
                <ProgressBar x:Name="DownloadProgress" Height="6" Margin="0,8,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" />
                <TextBlock x:Name="DownloadStatus" Foreground="#FF6B7280" FontSize="11" Margin="0,4,0,0" />

                <Separator Margin="0,16,0,12" />

                <TextBlock Text="Tastenkürzel" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Foreground="#FF374151" TextWrapping="Wrap" FontSize="12">
                    <Run Text="Ctrl+Alt+B – Blitztext" /><LineBreak />
                    <Run Text="Ctrl+Alt+L – Blitztext Lokal" /><LineBreak />
                    <Run Text="Ctrl+Alt+P – Blitztext+" /><LineBreak />
                    <Run Text="Ctrl+Alt+R – Blitztext $%&amp;!" /><LineBreak />
                    <Run Text="Ctrl+Alt+E – Blitztext :)" /><LineBreak />
                    <Run Text="Esc – Abbrechen" />
                </TextBlock>

                <Button x:Name="SaveButton" Content="Speichern &amp; schließen" Height="34" Margin="0,18,0,0"
                        Click="SaveButton_Click" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
