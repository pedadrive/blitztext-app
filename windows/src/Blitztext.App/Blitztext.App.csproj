<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Blitztext.App</RootNamespace>
    <AssemblyName>Blitztext</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- This is a WPF-hosted process: WPF reads Per-Monitor-V2 DPI awareness from the
         application manifest at startup, so the manifest is the correct place for it.
         WFAC010 is a WinForms-only analyzer that assumes a WinForms Application.Run entry
         point and recommends ApplicationHighDpiMode/SetHighDpiMode — neither of which runs
         in a WPF host, so following it would leave WPF system-DPI (blurry). Suppress it. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- The WindowsDesktop SDK's implicit usings omit System.IO; restore it project-wide
       (System.Net.Http is imported per file where needed). -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blitztext.Core\Blitztext.Core.csproj" />
  </ItemGroup>

</Project>
